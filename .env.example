# Development-only connection. Replace CHANGE_ME_DEV with a locally generated
# password before running any database command. This disposable identity may
# own astrotools_dev; it must never be reused in production.
DATABASE_URL="postgresql://astrotools_dev:CHANGE_ME_DEV@127.0.0.1:5432/astrotools_dev"

# Local development migrations use the same disposable database owner. In
# production this must instead be a separate controlled identity. Never point
# either value at a production database while using `npm run db:migrate:dev`.
MIGRATION_DATABASE_URL="postgresql://astrotools_dev:CHANGE_ME_DEV@127.0.0.1:5432/astrotools_dev"

# Prisma Migrate compares development schema changes in this separate,
# disposable shadow database. It must never be the same database as either URL
# above, and it is not required by `db:migrate:deploy` in production.
SHADOW_DATABASE_URL="postgresql://astrotools_dev:CHANGE_ME_DEV@127.0.0.1:5432/astrotools_shadow"

# Integration tests deliberately refuse the development database. Keep their
# two disposable identities in the gitignored `.env.integration` described in
# README.md; do not save test credentials in this file.

# Production keeps two independently managed secrets outside the repository:
#
# - the service receives DATABASE_URL for the least-privilege runtime identity;
# - the controlled release step receives MIGRATION_DATABASE_URL only while
#   running `npm run db:migrate:deploy` (and the reviewed seed step).
#
# Never place either production URL in this file or expose the migration
# identity to the long-running application service.
