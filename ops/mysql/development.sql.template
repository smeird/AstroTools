-- LOCAL DEVELOPMENT TEMPLATE ONLY.
-- Generate one 64-character hexadecimal value per distinct placeholder name
-- with `openssl rand -hex 32`. Replace every repeated occurrence of that name
-- with the same value; never reuse a value for a different identity or in
-- production. Hexadecimal values need no additional SQL or URL escaping.

CREATE DATABASE IF NOT EXISTS `astrotools_dev`
  CHARACTER SET utf8mb4
  COLLATE utf8mb4_unicode_ci;

CREATE DATABASE IF NOT EXISTS `astrotools_shadow`
  CHARACTER SET utf8mb4
  COLLATE utf8mb4_unicode_ci;

CREATE USER IF NOT EXISTS 'astrotools_dev'@'127.0.0.1'
  IDENTIFIED BY '{{DEV_PASSWORD}}';
ALTER USER 'astrotools_dev'@'127.0.0.1'
  IDENTIFIED BY '{{DEV_PASSWORD}}';
REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'astrotools_dev'@'127.0.0.1';
GRANT ALL PRIVILEGES ON `astrotools_dev`.*
  TO 'astrotools_dev'@'127.0.0.1';
GRANT ALL PRIVILEGES ON `astrotools_shadow`.*
  TO 'astrotools_dev'@'127.0.0.1';

CREATE DATABASE IF NOT EXISTS `astrotools_test`
  CHARACTER SET utf8mb4
  COLLATE utf8mb4_unicode_ci;

CREATE USER IF NOT EXISTS 'astrotools_test_migrate'@'127.0.0.1'
  IDENTIFIED BY '{{TEST_MIGRATION_PASSWORD}}';
ALTER USER 'astrotools_test_migrate'@'127.0.0.1'
  IDENTIFIED BY '{{TEST_MIGRATION_PASSWORD}}';
REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'astrotools_test_migrate'@'127.0.0.1';
GRANT ALL PRIVILEGES ON `astrotools_test`.*
  TO 'astrotools_test_migrate'@'127.0.0.1';

CREATE USER IF NOT EXISTS 'astrotools_test_app'@'127.0.0.1'
  IDENTIFIED BY '{{TEST_RUNTIME_PASSWORD}}';
ALTER USER 'astrotools_test_app'@'127.0.0.1'
  IDENTIFIED BY '{{TEST_RUNTIME_PASSWORD}}';
REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'astrotools_test_app'@'127.0.0.1';

