# Install as /etc/astrotools/backup.env with mode 0600. The GPG private key
# remains off-host; this value identifies the public encryption key.
BACKUP_GPG_RECIPIENT=CHANGE_ME_GPG_FINGERPRINT
BACKUP_DIR=/var/backups/astrotools
BACKUP_METRICS_FILE=/var/lib/node_exporter/textfile_collector/astrotools_backup.prom
BACKUP_RETENTION_DAYS=30
