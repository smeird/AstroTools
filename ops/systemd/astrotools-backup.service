[Unit]
Description=AstroTools encrypted MySQL backup
After=mysql.service
Wants=mysql.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/www/AstroTools/current
EnvironmentFile=/etc/astrotools/backup.env
ExecStart=/var/www/AstroTools/current/ops/mysql/backup.sh
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/astrotools /var/lib/node_exporter/textfile_collector
NoNewPrivileges=true
